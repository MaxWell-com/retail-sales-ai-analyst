# LLM served by Ollama (any model with tool calling; qwen2.5:7b runs on a 16 GB laptop, larger models answer better)
OLLAMA_URL=http://127.0.0.1:11434
VT_MODEL=qwen2.5:7b
VT_NUM_CTX=32768

# Data
VT_DB=data/retail.duckdb
VT_STORE=data/app_data
VT_MEMORY=4GB

# The company the analyst works for (its categories are the default analysis scope)
VT_OWN_MANUFACTURER=NORD

# Web server
PORT=8765
